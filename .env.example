# ==============================================================================
# PharmaPredict AI Environment Configuration
# Copy this file to .env and customize for your local or production environment.
# DO NOT COMMIT SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Environment
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
SECRET_KEY=change-this-in-production-use-a-strong-random-key

# Database Configuration (PostgreSQL / TimescaleDB)
# For local development without Docker, leave commented or empty to default to SQLite.
DATABASE_URL=postgresql://pharmapredict:pharma_secure_pass@localhost:5432/pharmapredict_db
# TimescaleDB / Time-series URL (can point to same database if Timescale extension is enabled)
TIMESCALEDB_URL=postgresql://pharmapredict:pharma_secure_pass@localhost:5432/pharmapredict_db

# CORS Allowed Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Frontend Public Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=PharmaPredict AI

# Industrial Connectivity / Edge Gateway
OPC_UA_SERVER_ENDPOINT=opc.tcp://localhost:4840/freeopcua/server/
OPC_UA_SECURITY_POLICY=Basic256Sha256
OPC_UA_SECURITY_MODE=SignAndEncrypt

# Background Worker & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

