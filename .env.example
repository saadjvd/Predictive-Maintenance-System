# ==============================================================================
# PharmaPredict AI — Environment Configuration Template
# Copy this file to .env and configure for your local, staging, or production setup.
#
# IMPORTANT PHARMACEUTICAL COMPLIANCE NOTICE:
# DO NOT COMMIT SECRETS, PRIVATE KEYS, OR REAL CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT PROFILE
# ------------------------------------------------------------------------------
# Options: development | staging | production | testing
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Application Identity
APP_NAME=PharmaPredict AI
APP_VERSION=1.0.0

# Security Secret Key
# - Development: Default key permitted for local testing.
# - Staging: Minimum 16 random characters.
# - Production: Cryptographically random key with minimum 32 characters (REQUIRED).
SECRET_KEY=dev-pharma-predict-secret-key-change-in-prod-2026

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / TimescaleDB)
# ------------------------------------------------------------------------------
# For lightweight development, leave DATABASE_URL unset/empty to default to local SQLite.
# For Docker Compose development:
DATABASE_URL=postgresql://pharmapredict:pharma_secure_pass@localhost:5432/pharmapredict_db
TIMESCALEDB_URL=postgresql://pharmapredict:pharma_secure_pass@localhost:5432/pharmapredict_db

# Database user credentials for Docker containers
POSTGRES_USER=pharmapredict
POSTGRES_PASSWORD=pharma_secure_pass
POSTGRES_DB=pharmapredict_db

# Database Migration Controls
# Set AUTO_MIGRATE=true for automated migration execution on startup.
# Set ENFORCE_MIGRATION_CHECK=true to abort startup if pending migrations exist.
AUTO_MIGRATE=false
ENFORCE_MIGRATION_CHECK=false

# ------------------------------------------------------------------------------
# 3. REDIS & BACKGROUND QUEUE
# ------------------------------------------------------------------------------
# Redis connection URL for task queue, rate limiting, and telemetry buffer.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 4. CORS & FRONTEND INTEGRATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js Public Settings
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME=PharmaPredict AI
BACKEND_INTERNAL_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 5. INDUSTRIAL CONNECTIVITY & EDGE GATEWAY (OPC UA)
# ------------------------------------------------------------------------------
OPC_UA_SERVER_ENDPOINT=opc.tcp://localhost:4840/freeopcua/server/
OPC_UA_SECURITY_POLICY=Basic256Sha256
OPC_UA_SECURITY_MODE=SignAndEncrypt

# ------------------------------------------------------------------------------
# 6. CMMS INTEGRATION (SAP PM / IBM Maximo) — Phase 10 Mock Profiles
# ------------------------------------------------------------------------------
# Default to mock connectors until authorized production credentials are provided.
CMMS_CONNECTOR_TYPE=mock
CMMS_API_ENDPOINT=
CMMS_API_KEY=
CMMS_SYNC_READONLY=true
